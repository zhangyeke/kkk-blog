generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id            Int          @id @default(autoincrement())
  categoryId    Int
  pv            Int?         @default(0)
  cover         String       @default("")
  tags          String       @default("")
  title         String       @default("")
  content       String       @default("")
  /// 文章状态 0：下架 1：正常 2：草稿
  status        Int?         @default(1)
  createdAt     DateTime?    @default(now()) @db.Timestamp(6)
  userId        String       @db.Uuid
  favoriteCount Int          @default(0)
  updatedAt     DateTime     @default(now()) @updatedAt
  favorites     Favorite[]
  category      PostCategory @relation(fields: [categoryId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostCategory {
  id        Int      @id @default(autoincrement())
  name      String
  icon      String?
  status    Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt
  posts     Post[]
}

model User {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String      @default("NO_NAME")
  email         String      @unique(map: "user_email_idx")
  emailVerified DateTime?   @default(now()) @db.Timestamp(6)
  avatar        String?
  roles         String      @default("user")
  address       Json?       @db.Json
  createdAt     DateTime    @default(now()) @db.Timestamp(6)
  updatedAt     DateTime    @default(now()) @updatedAt
  password      String?
  // 生日，使用时间戳类型
  birthday      DateTime?   @db.Timestamp(6)
  // 性别
  gender        Int?
  accounts      Account[]
  favorites     Favorite[]
  footprints    Footprint[]
  posts         Post[]
  session       Session[]
  bookmarks     Bookmark[]
}

/// 书签分类
model BookmarkCategory {
  id        Int        @id @default(autoincrement())
  name      String
  /// 0：禁用 1：正常（与其它模型 status 约定一致时可按需扩展）
  status    Int        @default(1)
  createdAt DateTime   @default(now()) @db.Timestamp(6)
  updatedAt DateTime   @default(now()) @updatedAt
  bookmarks Bookmark[]
}

/// 书签
model Bookmark {
  id         Int              @id @default(autoincrement())
  /// 网站链接
  url        String
  title      String
  intro      String?          @default("")
  /// 网站 favicon 等图标地址
  icon       String?          @default("")
  /// 0：禁用 1：正常
  status     Int              @default(1)
  /// 前台书签的累计点击量
  clickCount Int              @default(0)
  userId     String           @db.Uuid
  categoryId Int
  createdAt  DateTime         @default(now()) @db.Timestamp(6)
  updatedAt  DateTime         @default(now()) @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   BookmarkCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([categoryId])
}

/// 用户足迹
model Footprint {
  id        Int      @id @default(autoincrement())
  userId    String   @db.Uuid
  province  Int
  city      Int
  area      Int?
  address   String?
  album     String[] @default([])
  /// 拍摄/地点坐标，存 WGS-84 原始坐标系；渲染时按境内/境外决定是否转 GCJ-02
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now()) @db.Timestamp(6)
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lat, lng])
}

model Favorite {
  userId    String   @db.Uuid
  postId    Int
  createdAt DateTime @default(now()) @db.Timestamp(6)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Account {
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime @default(now()) @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

enum AdminMenuSurface {
  ADMIN
  BLOG
}

enum AdminMenuPosition {
  ADMIN
  BLOG_NAV
  USER_BRIEF
}

/// 后台角色。code 是业务主键 —— User.roles 逗号串里存的就是 code。
model Role {
  id          Int              @id @default(autoincrement())
  /// 唯一标识：superAdmin / admin / user / editor…；创建后不可修改
  code        String           @unique(map: "Role_code_key")
  /// 显示名（内置角色也允许改）
  name        String
  description String?
  /// 内置角色：不可删除、不可停用、不可改 code
  isBuiltin   Boolean          @default(false)
  /// 0：停用 1：正常
  status      Int              @default(1)
  /// 数据范围：true = 全量，false = 仅自己（喂给 resolveScope）
  scopeAll    Boolean          @default(false)
  sort        Int              @default(0)
  createdAt   DateTime         @default(now()) @db.Timestamp(6)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  permissions RolePermission[]

  @@index([status, sort])
}

/// 后台菜单树：目录(dir)/菜单(menu)/按钮(button) 同表。
/// permissionKey 是权限判定唯一标识，RolePermission.permissionKey 直接指向它。
/// 目录 permissionKey 为 null（纯分组）；菜单/按钮必须非空（service 层强制）。
model AdminMenu {
  id            Int               @id @default(autoincrement())
  surface       AdminMenuSurface  @default(ADMIN)
  position      AdminMenuPosition @default(ADMIN)
  parentId      Int?
  name          String
  type          String            @db.VarChar(16)
  icon          String?
  path          String?
  component     String?
  componentName String?
  permissionKey String?           @unique(map: "AdminMenu_permissionKey_key")
  sort          Int               @default(0)
  status        Int               @default(1)
  visible       Boolean           @default(true)
  alwaysShow    Boolean           @default(false)
  keepAlive     Boolean           @default(false)
  isBuiltin     Boolean           @default(false)
  createdAt     DateTime          @default(now()) @db.Timestamp(6)
  updatedAt     DateTime          @default(now()) @updatedAt @db.Timestamp(6)

  parent   AdminMenu?  @relation("AdminMenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children AdminMenu[] @relation("AdminMenuTree")

  @@index([parentId, sort])
  @@index([surface, parentId, sort])
  @@index([position, parentId, sort])
  @@index([type, status, visible])
  @@index([status, sort])
}

/// 角色 → 权限 key 的授权关系。key 取值由代码字典定义，DB 只存关系。
model RolePermission {
  id            Int      @id @default(autoincrement())
  /// 引用 Role.code（不是 id）—— 判定时手上只有 code
  roleCode      String
  /// page:<AdminPage> | action:<AdminAction>，如 page:posts / action:post:delete
  permissionKey String
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  role          Role     @relation(fields: [roleCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleCode, permissionKey], map: "RolePermission_roleCode_permissionKey_key")
}

/// 后台设置分组：固定品牌分组与用户自定义 Tab 共用。
model AdminSettingGroup {
  id          Int                 @id @default(autoincrement())
  /// 稳定读取标识；创建后不变。
  key         String              @unique(map: "AdminSettingGroup_key_key") @db.VarChar(80)
  name        String              @db.VarChar(100)
  description String?             @db.VarChar(240)
  sort        Int                 @default(0)
  isBuiltin   Boolean             @default(false)
  createdAt   DateTime            @default(now()) @db.Timestamp(6)
  updatedAt   DateTime            @default(now()) @updatedAt @db.Timestamp(6)
  fields      AdminSettingField[]

  @@index([sort, id])
}

/// 后台设置字段定义和值；config 仅保存受校验的声明式控件参数。
model AdminSettingField {
  id          Int               @id @default(autoincrement())
  groupId     Int
  /// 在分组内稳定读取标识；创建后不变。
  key         String            @db.VarChar(80)
  label       String            @db.VarChar(100)
  type        String            @db.VarChar(32)
  required    Boolean           @default(false)
  description String?           @db.VarChar(240)
  config      Json              @default("{}") @db.JsonB
  value       Json?             @db.JsonB
  sort        Int               @default(0)
  isBuiltin   Boolean           @default(false)
  createdAt   DateTime          @default(now()) @db.Timestamp(6)
  updatedAt   DateTime          @default(now()) @updatedAt @db.Timestamp(6)
  group       AdminSettingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key], map: "AdminSettingField_groupId_key_key")
  @@index([groupId, sort, id])
}
